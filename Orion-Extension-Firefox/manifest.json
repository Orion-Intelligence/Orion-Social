{
  "manifest_version": 2,
  "name": "Orion Social Scraper",
  "description": "Browser-assisted social scraping executor for Orion.",
  "version": "0.2.1",
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Orion Social Scraper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "https://127.0.0.1:8443/*",
    "https://localhost:8443/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:4200/*",
    "http://localhost:4200/*",
    "http://127.0.0.1:8020/*",
    "http://localhost:8020/*",
    "https://*.reddit.com/*",
    "https://reddit.com/*",
    "https://*.linkedin.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://*.github.com/*"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'self' https://127.0.0.1:8443 https://localhost:8443 http://127.0.0.1:8080 http://localhost:8080 http://127.0.0.1:4200 http://localhost:4200 http://127.0.0.1:8020 http://localhost:8020 ws://127.0.0.1:8020 ws://localhost:8020;",
  "content_scripts": [
    {
      "matches": [
        "https://127.0.0.1:8443/*",
        "https://localhost:8443/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:4200/*",
        "http://localhost:4200/*"
      ],
      "js": ["orion-auth-content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "orion-social-scraper@orion.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "websiteActivity",
          "websiteContent"
        ],
        "optional": []
      }
    }
  }
}
