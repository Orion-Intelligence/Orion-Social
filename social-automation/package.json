{
  "name": "@orion/social-automation",
  "version": "2.0.0",
  "description": "Orion social-media session manager and multi-platform publisher – persistent browser profiles for automated social platform interactions",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "social:status": "tsx src/cli/status.ts",
    "social:post": "tsx src/cli/post.ts",
    "social:detect-ads": "tsx src/cli/detect-x-ads.ts",
    "social:detect-ig-ads": "tsx src/cli/detect-ig-ads.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "playwright": "^1.51.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
