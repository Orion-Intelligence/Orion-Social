FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    APT_LISTCHANGES_FRONTEND=none \
    TRIVY_CACHE_DIR=/root/.cache/trivy

RUN set -eux; \
    apt-get -o Acquire::Retries=3 update; \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      build-essential \
      gcc \
      curl \
      wget \
      git \
      ca-certificates \
      gnupg \
      libnss3 \
      libnspr4 \
      libdbus-1-3 \
      libx11-xcb1 \
      libxcomposite1 \
      libxrandr2 \
      libxdamage1 \
      libxfixes3 \
      libxkbcommon0 \
      libxext6 \
      libxshmfence1 \
      libasound2 \
      libgbm1 \
      libgtk-3-0 \
      libfontconfig1 \
      libcups2 \
      libcairo2 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      poppler-utils \
      tesseract-ocr \
      openjdk-21-jre \
      openjdk-21-jdk-headless \
      unzip \
    ; \
    install -d -m 0755 /usr/share/keyrings /etc/apt/sources.list.d; \
    curl -fsSL https://get.trivy.dev/deb/public.key | gpg --dearmor -o /usr/share/keyrings/trivy.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://get.trivy.dev/deb generic main" \
      > /etc/apt/sources.list.d/trivy.list; \
    apt-get -o Acquire::Retries=3 update; \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends trivy; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in amd64) SUBF_ARCH="amd64" ;; arm64) SUBF_ARCH="arm64" ;; *) exit 1 ;; esac && \
    curl -fsSL -o /tmp/subfinder.zip https://github.com/projectdiscovery/subfinder/releases/download/v2.6.5/subfinder_2.6.5_linux_${SUBF_ARCH}.zip && \
    unzip /tmp/subfinder.zip -d /usr/local/bin && \
    chmod +x /usr/local/bin/subfinder

RUN subfinder -version

RUN python3 -m ensurepip \
 && pip install --upgrade pip \
 && pip install playwright \
 && playwright install chromium

COPY app/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

RUN python -m spacy download en_core_web_trf

COPY app /app
RUN pip install --no-cache-dir sentence-transformers torch transformers \
 && python - <<'PY'
from sentence_transformers import SentenceTransformer
m = SentenceTransformer("BAAI/bge-small-en-v1.5")
m.save("/app/raw/model/semantic")
PY

COPY config /app
WORKDIR /app

EXPOSE 8010
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8010"]
