FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    APT_LISTCHANGES_FRONTEND=none

RUN set -eux; \
    apt-get -o Acquire::Retries=3 update; \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
      build-essential \
      gcc \
      pkg-config \
      curl \
      wget \
      git \
      ca-certificates \
      gnupg \
      libnss3 \
      libnspr4 \
      libdbus-1-3 \
      libx11-xcb1 \
      libxcomposite1 \
      libxrandr2 \
      libxdamage1 \
      libxfixes3 \
      libxkbcommon0 \
      libxext6 \
      libxshmfence1 \
      libasound2 \
      libgbm1 \
      libgtk-3-0 \
      libfontconfig1 \
      libcups2 \
      libcairo2 \
      libcairo2-dev \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      poppler-utils \
      tesseract-ocr \
      openjdk-21-jre \
      openjdk-21-jdk-headless \
      unzip \
    ; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in amd64) SUBF_ARCH="amd64" ;; arm64) SUBF_ARCH="arm64" ;; *) exit 1 ;; esac && \
    curl -fsSL -o /tmp/subfinder.zip https://github.com/projectdiscovery/subfinder/releases/download/v2.6.5/subfinder_2.6.5_linux_${SUBF_ARCH}.zip && \
    unzip /tmp/subfinder.zip -d /usr/local/bin && \
    chmod +x /usr/local/bin/subfinder

RUN subfinder -version

RUN curl -fsSL https://raw.githubusercontent.com/sundowndev/phoneinfoga/master/support/scripts/install | bash \
 && mv ./phoneinfoga /usr/local/bin/phoneinfoga \
 && chmod +x /usr/local/bin/phoneinfoga \
 && phoneinfoga version

RUN python3 -m ensurepip \
 && pip install --upgrade pip \
 && pip install playwright \
 && playwright install chromium

COPY app/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

COPY app /app
COPY crawler /app/crawler
COPY config /app
COPY Orion-Extension /app/Orion-Extension
COPY Orion-Extension-Firefox /app/Orion-Extension-Firefox

WORKDIR /app

EXPOSE 8010
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8020"]
